{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FabbriMatteo6/AIXS/experiments/schema/v0.1/experiment.schema.json",
  "title": "AIXS experiment metadata v0.1",
  "type": "object",
  "required": ["schema_version", "experiment_id", "mission", "title", "status", "hypothesis", "hardware_profile", "software", "workload", "artifacts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "experiment_id": {"type": "string", "pattern": "^M[0-9]{2}-E[0-9]{3}$"},
    "mission": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["planned", "running", "completed", "failed", "inconclusive", "superseded"]},
    "hypothesis": {"type": "string"},
    "hardware_profile": {"type": "string"},
    "hardware_role": {"enum": ["reference", "exploratory", "replication"]},
    "model": {"type": "object"},
    "software": {"type": "object"},
    "workload": {"type": "object"},
    "measurements": {"type": "object"},
    "artifacts": {"type": "array"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
